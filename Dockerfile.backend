FROM python:3.11-slim

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT=/opt/venv

COPY --from=ghcr.io/astral-sh/uv:0.11.0 /uv /bin/

COPY pyproject.toml .
COPY uv.lock* .
RUN uv sync --no-install-project

# Install docker CLI so the backend can launch one-shot sandbox containers.
# This keeps the image minimal while enabling `docker run` against the host
# socket which will be mounted by docker-compose when desired.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends docker.io ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

COPY . .

CMD ["uv", "run", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]